# Tracenixa Environment Configuration Template
# Copy this file to .env before starting containers

# Database Configuration (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tracenixa
DB_USER=tracenixa
DB_PASSWORD=tracenixa_secret_password

# Apache Kafka (KRaft mode)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
USE_KAFKA=true

# Security & Authentication
JWT_SECRET=tracenixa-platform-super-secure-production-ready-jwt-secret-key-32bytes-min!

# AI Model Provider (Optional: if empty, built-in deterministic sandbox model is used)
OPENAI_API_KEY=
